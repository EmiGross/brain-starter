{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/daily-kurz.sh 2>/dev/null || true",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Lade neueste Daily-Note…"
          },
          {
            "type": "command",
            "command": "bash .claude/stand-check.sh 2>/dev/null || true",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Stand-Check…"
          }
        ]
      }
    ]
  }
}

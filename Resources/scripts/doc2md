#!/usr/bin/env python3
"""doc2md - Dokumente nach Markdown, optional gesplittet.

PDF laeuft standardmaessig ueber markitdown (18-42% weniger Zeichen als
pdftotext, weil Layout-Leerraum wegfaellt). Mit --layout stattdessen
pdftotext -layout, wenn Spalten und Tabellen originalgetreu bleiben sollen.
docx/xlsx/pptx laufen immer ueber markitdown.

  doc2md buch.pdf                     ganze Datei -> buch.md
  doc2md buch.pdf --toc               Seitenuebersicht, konvertiert nichts
  doc2md buch.pdf --pages 40-75       nur dieser Seitenbereich
  doc2md buch.pdf --chunk 25          25-Seiten-Teile -> buch/teil-001.md ...
  doc2md rechnung.pdf --layout        originalgetreue Spalten statt Fliesstext
  doc2md tabelle.xlsx                 Office-Datei -> tabelle.md
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile

TOKEN_PER_CHAR = 1 / 3  # grobe Hausnummer, reicht zum Abschaetzen


def de(n):
    return f"{n:,}".replace(",", ".")


def die(msg):
    print(f"fehler: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, quiet_stderr=True):
    r = subprocess.run(cmd, capture_output=True)
    if r.returncode != 0:
        err = r.stderr.decode("utf-8", "replace").strip()[:300]
        die(f"{os.path.basename(cmd[0])} brach ab: {err}")
    return r.stdout.decode("utf-8", "replace")


def need(tool, hint):
    p = shutil.which(tool)
    if not p:
        die(f"{tool} fehlt. {hint}")
    return p


# --- Tabellen aufraeumen -----------------------------------------------------

def clean_tables(md):
    """markitdown schreibt bei Tabellenblaettern leere Zellen als 'NaN' und
    behaelt komplett leere Spalten. Beides kostet Token ohne Inhalt."""
    lines = md.split("\n")
    out, i = [], 0
    while i < len(lines):
        if lines[i].lstrip().startswith("|"):
            j = i
            while j < len(lines) and lines[j].lstrip().startswith("|"):
                j += 1
            out.extend(_clean_block(lines[i:j]))
            i = j
        else:
            out.append(lines[i])
            i += 1
    return "\n".join(out)


def _split_row(line):
    return [c.strip() for c in line.strip().strip("|").split("|")]


def _is_sep(cells):
    return all(re.fullmatch(r":?-{2,}:?", c or "") for c in cells) and cells


def _clean_block(block):
    rows = [_split_row(l) for l in block]
    width = max(len(r) for r in rows)
    rows = [r + [""] * (width - len(r)) for r in rows]
    for r in rows:
        for k, c in enumerate(r):
            if c == "NaN":
                r[k] = ""

    data = [r for r in rows if not _is_sep(r)]
    keep = [k for k in range(width)
            if any((r[k] or "") for r in data[1:])       # Inhalt unter der Kopfzeile
            or any((r[k] or "") for r in data[:1]) and len(data) <= 1]
    if not keep:
        keep = list(range(width))

    result = []
    for r in rows:
        cells = [r[k] for k in keep]
        if _is_sep(r):
            result.append("| " + " | ".join("---" for _ in keep) + " |")
        elif any(cells):
            result.append("| " + " | ".join(cells) + " |")
    return result


# --- Extraktion --------------------------------------------------------------

def page_count(pdf):
    for line in run([need("pdfinfo", "brew install poppler"), pdf]).splitlines():
        if line.startswith("Pages:"):
            return int(line.split()[1])
    die("Seitenzahl nicht lesbar")


def pdftotext_text(pdf, first=None, last=None):
    cmd = [need("pdftotext", "brew install poppler"), "-layout"]
    if first:
        cmd += ["-f", str(first)]
    if last:
        cmd += ["-l", str(last)]
    return run(cmd + [pdf, "-"])


def markitdown_text(path):
    exe = need("markitdown", "installieren mit: uv tool install 'markitdown[all]'")
    return clean_tables(run([exe, path]))


def extract_range(pdf, first, last):
    """Seitenbereich als eigenes PDF herausschneiden, damit markitdown ihn sieht."""
    with tempfile.TemporaryDirectory() as tmp:
        run([need("pdfseparate", "brew install poppler"),
             "-f", str(first), "-l", str(last), pdf, os.path.join(tmp, "p-%d.pdf")])
        parts = sorted((f for f in os.listdir(tmp) if f.endswith(".pdf")),
                       key=lambda f: int(re.search(r"(\d+)", f).group(1)))
        if not parts:
            die(f"keine Seiten in {first}-{last}")
        merged = os.path.join(tmp, "_range.pdf")
        run([need("pdfunite", "brew install poppler")] +
            [os.path.join(tmp, p) for p in parts] + [merged])
        return markitdown_text(merged)


def pdf_text(pdf, use_layout, first=None, last=None):
    if use_layout or not shutil.which("markitdown"):
        return pdftotext_text(pdf, first, last)
    if first is None:
        return markitdown_text(pdf)
    return extract_range(pdf, first, last)


def looks_scanned(pdf, pages):
    sample = min(pages, 10)
    body = re.sub(r"\s", "", pdftotext_text(pdf, 1, sample))
    return len(body) < sample * 100


def show_toc(pdf, pages):
    print(f"{os.path.basename(pdf)}: {pages} Seiten\n")
    for p in range(1, pages + 1):
        head = next((l.strip()[:78] for l in pdftotext_text(pdf, p, p).splitlines()
                     if l.strip()), "")
        print(f"  S.{p:>4}  {head}")


def write(path, text):
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)
    n = len(text)
    print(f"  {path}  ({de(n)} Zeichen, ~{de(int(n * TOKEN_PER_CHAR))} Token)")


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("datei", nargs="?")
    ap.add_argument("--toc", action="store_true")
    ap.add_argument("--pages", metavar="A-B")
    ap.add_argument("--chunk", type=int, metavar="N")
    ap.add_argument("--layout", action="store_true")
    ap.add_argument("-o", "--out", metavar="ZIEL")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()

    if a.help or not a.datei:
        print(__doc__)
        return

    src = a.datei
    if not os.path.isfile(src):
        die(f"gibt es nicht: {src}")

    ext = os.path.splitext(src)[1].lower()
    stem = os.path.splitext(os.path.basename(src))[0]

    if ext != ".pdf":
        if a.chunk or a.pages or a.toc or a.layout:
            die("--toc, --pages, --chunk und --layout gibt es nur fuer PDF")
        write(a.out or f"{stem}.md", markitdown_text(src))
        return

    pages = page_count(src)

    if a.toc:
        show_toc(src, pages)
        return

    if looks_scanned(src, pages):
        print(f"warnung: {stem} sieht nach Scan ohne Textebene aus.", file=sys.stderr)
        print("         Textextraktion bringt hier nichts, das PDF muss visuell "
              "gelesen oder vorher durch OCR.", file=sys.stderr)

    if a.pages:
        m = re.fullmatch(r"(\d+)\s*-\s*(\d+)", a.pages.strip())
        if not m:
            die("--pages braucht die Form 40-75")
        first, last = int(m.group(1)), int(m.group(2))
        if first < 1 or last > pages or first > last:
            die(f"Seitenbereich {first}-{last} passt nicht zu {pages} Seiten")
        write(a.out or f"{stem}_S{first}-{last}.md", pdf_text(src, a.layout, first, last))
        return

    if a.chunk:
        if a.chunk < 1:
            die("--chunk braucht eine Zahl groesser 0")
        outdir = a.out or stem
        total = (pages + a.chunk - 1) // a.chunk
        print(f"{stem}: {pages} Seiten -> {total} Teile a {a.chunk} Seiten")
        for i, first in enumerate(range(1, pages + 1, a.chunk), start=1):
            last = min(first + a.chunk - 1, pages)
            body = pdf_text(src, a.layout, first, last)
            head = (f"---\ntype: quelle\nquelle: {stem}\nseiten: {first}-{last}\n"
                    f"teil: {i}/{total}\n---\n\n")
            write(os.path.join(outdir, f"teil-{i:03d}.md"), head + body)
        return

    write(a.out or f"{stem}.md", pdf_text(src, a.layout))


if __name__ == "__main__":
    main()
